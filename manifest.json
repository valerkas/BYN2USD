{
  "manifest_version": 3,
  "name": "BYN2USD",
  "version": "1.0.9",
  "description": "Показывает эквивалент цен в USD по курсу НБРБ рядом с ценами в BYN на av.by и re.kufar.by.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.nbrb.by/*",
    "https://av.by/*",
    "https://*.av.by/*",
    "https://re.kufar.by/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://av.by/*",
        "https://*.av.by/*",
        "https://re.kufar.by/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "BYN to USD",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
